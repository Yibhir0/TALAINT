# Local development
DATABASE_URL=postgres://talaint:talaint@localhost:5432/talaint

# Initial admin token for `talaint auth login --admin --token $TALAINT_ADMIN_TOKEN`
# TALAINT_ADMIN_TOKEN=

# Secrets (envelope encryption KEK) - set a real 32-byte base64 key for real use
# TALAINT_KEK_BASE64=

# Example: secret value env vars consumed by `secrets set <name>`
# TALAINT_SECRET_EXAMPLE=changeme
